{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-reconcile",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "minify": true,
  "vars": {
    "XGUARD_TREASURY_USDC_ADDRESS": "0x4f32f8fe1ee3e9f5c5a6587dc019a13bb453ba07",
    "X402_FACILITATOR": "https://facilitator.xpay.sh",
    "BASE_RPC_URL": "https://mainnet.base.org"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.2 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "routes": [
    { "pattern": "reconcile.xguardgate.com", "custom_domain": true }
  ]
}
