{
  "name": "xguard-reconcile",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:validators": "node scripts/generate-validators.mjs",
    "check": "node --check src/index.js && node --check src/discovery-entry.js && node scripts/generate-validators.mjs --check && node --test test/discovery-entry.mjs test/standalone-validators.mjs test/production-smoke.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build --config wrangler.jsonc",
    "test:workerd": "npm run build && node --test test/reconcile-workerd.mjs"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/extensions": "2.24.0",
    "@x402/hono": "2.24.0",
    "hono": "^4.12.27",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "miniflare": "5.20261001.0-alpha",
    "wrangler": "4.147.0"
  }
}
