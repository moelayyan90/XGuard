{
  "name": "xguard-mainnet",
  "main": "src/live-entry.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTAS",
        "class_name": "MerchantQuota"
      },
      {
        "name": "RECEIPTS",
        "class_name": "SettlementReceipt"
      },
      {
        "name": "AUTHORITY",
        "class_name": "AgentAuthority"
      },
      {
        "name": "RAIL_KEYS",
        "class_name": "RailKeyAuthority"
      },
      {
        "name": "RAIL_PERMITS",
        "class_name": "RailPermitState"
      },
      {
        "name": "RAIL_METER",
        "class_name": "RailMeter"
      },
      {
        "name": "ACTION_KEYS",
        "class_name": "ActionKeyAuthority"
      },
      {
        "name": "ACTION_PERMITS",
        "class_name": "ActionPermitState"
      },
      {
        "name": "ACTION_METER",
        "class_name": "ActionMeter"
      },
      {
        "name": "EGRESS_KEYS",
        "class_name": "EgressKeyAuthority"
      },
      {
        "name": "EGRESS_CREDENTIALS",
        "class_name": "EgressCredentialState"
      },
      {
        "name": "EGRESS_TENANTS",
        "class_name": "EgressTenantIndex"
      },
      {
        "name": "EGRESS_CAPABILITIES",
        "class_name": "EgressCapabilityState"
      },
      {
        "name": "EGRESS_METER",
        "class_name": "EgressMeter"
      },
      {
        "name": "PROOF_AUTHORITY",
        "class_name": "ProofAuthority"
      },
      {
        "name": "PAID_GATEWAY",
        "class_name": "PaidGatewayState"
      },
      {
        "name": "LIVE_SHARDS",
        "class_name": "LiveShard"
      },
      {
        "name": "LIVE_CONTROL",
        "class_name": "LiveControl"
      },
      {
        "name": "C2SP_WITNESS",
        "class_name": "C2SPWitness"
      }
    ]
  },
  "migrations": [
    {
      "tag": "relay-v1",
      "new_sqlite_classes": [
        "MerchantQuota"
      ]
    },
    {
      "tag": "relay-v2",
      "new_sqlite_classes": [
        "SettlementReceipt"
      ]
    },
    {
      "tag": "relay-v3",
      "new_sqlite_classes": [
        "AgentAuthority"
      ]
    },
    {
      "tag": "relay-v4",
      "new_sqlite_classes": [
        "RailKeyAuthority",
        "RailPermitState",
        "RailMeter"
      ]
    },
    {
      "tag": "relay-v5",
      "new_sqlite_classes": [
        "ActionKeyAuthority",
        "ActionPermitState",
        "ActionMeter"
      ]
    },
    {
      "tag": "relay-v6",
      "new_sqlite_classes": [
        "EgressKeyAuthority",
        "EgressCredentialState",
        "EgressTenantIndex",
        "EgressCapabilityState",
        "EgressMeter"
      ]
    },
    {
      "tag": "relay-v7",
      "new_sqlite_classes": [
        "ProofAuthority"
      ]
    },
    {
      "tag": "relay-v8",
      "new_sqlite_classes": [
        "PaidGatewayState"
      ]
    },
    {
      "tag": "relay-v9-live",
      "new_sqlite_classes": [
        "LiveShard",
        "LiveControl"
      ]
    },
    {
      "tag": "relay-v10-c2sp",
      "new_sqlite_classes": [
        "C2SPWitness"
      ]
    }
  ],
  "workers_dev": false,
  "preview_urls": true,
  "previews": {
    "vars": {
      "XGUARD_CHECKOUT_SANDBOX_PREVIEW": "on",
      "LIVE_SOURCE_FETCHES": "off",
      "LIVE_BOOTSTRAP": "off",
      "XGUARD_ACTION_DAILY_ORDERS": "10"
    },
    "version_metadata": {
      "binding": "CF_VERSION_METADATA"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "PROOF_AUTHORITY",
          "class_name": "ProofAuthority"
        },
        {
          "name": "PAID_GATEWAY",
          "class_name": "PaidGatewayState"
        }
      ]
    },
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "head_sampling_rate": 1
      }
    }
  }
}
