{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-mainnet",
  "main": "src/canonical-entry.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Canonical custom domains are provisioned separately because the CI token is
  // intentionally limited to Workers Scripts. Post-deploy verification enforces
  // the apex, www redirect and API surfaces without requiring Zone Routes access.
  "minify": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "X402_GLOBAL_PRIMARY": "https://facilitator.payai.network",
    "X402_BASE_PRIMARY": "https://facilitator.xpay.sh",
    "X402_BASE_SECONDARY": "https://facilitator.openx402.ai",
    "X402_MULTI": "https://x402.dexter.cash",
    "XGUARD_PAID_FACILITATOR": "https://facilitator.xpay.sh",
    "XGUARD_TESTNET_FACILITATOR": "https://facilitator.xpay.sh",
    "XGUARD_PAYMENT_ENVIRONMENT": "production",
    "XGUARD_TREASURY_USDC_ADDRESS": "0x4f32f8fe1ee3e9f5c5a6587dc019a13bb453ba07",
    "XGUARD_TESTNET_PAY_TO": "0x4f32f8fe1ee3e9f5c5a6587dc019a13bb453ba07",
    "XGUARD_WEB_FETCH_PRICE_ATOMIC": "1000",
    "XGUARD_MARGIN_USD_MICROS": "1000",
    "XGUARD_TESTNET_WEB_FETCH_PRICE_ATOMIC": "1000",
    "XGUARD_TESTNET_MARGIN_USD_MICROS": "1000",
    "XGUARD_BILLING_URL": "https://hooks.xguardgate.com",
    "XGUARD_CHECKOUT_URL": "https://xguardgate.com/pricing",
    "BASE_RPC_URL": "https://mainnet.base.org",
    "FREE_SETTLEMENTS": "25",
    "SETTLEMENT_CREDITS": "2",
    "RECOVERY_WINDOW_MS": "24000",
    "FREE_EDGE_TRANSACTIONS": "1000",
    "EDGE_TRANSACTION_CREDITS": "1",
    "RAIL_FEE_USD_MICROS": "1000",
    "ACTION_EXECUTION_CREDITS": "1",
    "EGRESS_EXECUTION_CREDITS": "1"
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUOTAS", "class_name": "MerchantQuota" },
      { "name": "RECEIPTS", "class_name": "SettlementReceipt" },
      { "name": "AUTHORITY", "class_name": "AgentAuthority" },
      { "name": "RAIL_KEYS", "class_name": "RailKeyAuthority" },
      { "name": "RAIL_PERMITS", "class_name": "RailPermitState" },
      { "name": "RAIL_METER", "class_name": "RailMeter" },
      { "name": "ACTION_KEYS", "class_name": "ActionKeyAuthority" },
      { "name": "ACTION_PERMITS", "class_name": "ActionPermitState" },
      { "name": "ACTION_METER", "class_name": "ActionMeter" },
      { "name": "EGRESS_KEYS", "class_name": "EgressKeyAuthority" },
      { "name": "EGRESS_CREDENTIALS", "class_name": "EgressCredentialState" },
      { "name": "EGRESS_TENANTS", "class_name": "EgressTenantIndex" },
      { "name": "EGRESS_CAPABILITIES", "class_name": "EgressCapabilityState" },
      { "name": "EGRESS_METER", "class_name": "EgressMeter" },
      { "name": "PROOF_AUTHORITY", "class_name": "ProofAuthority" },
      { "name": "PAID_GATEWAY", "class_name": "PaidGatewayState" }
    ]
  },
  "migrations": [
    { "tag": "relay-v1", "new_sqlite_classes": ["MerchantQuota"] },
    { "tag": "relay-v2", "new_sqlite_classes": ["SettlementReceipt"] },
    { "tag": "relay-v3", "new_sqlite_classes": ["AgentAuthority"] },
    { "tag": "relay-v4", "new_sqlite_classes": ["RailKeyAuthority", "RailPermitState", "RailMeter"] },
    { "tag": "relay-v5", "new_sqlite_classes": ["ActionKeyAuthority", "ActionPermitState", "ActionMeter"] },
    { "tag": "relay-v6", "new_sqlite_classes": ["EgressKeyAuthority", "EgressCredentialState", "EgressTenantIndex", "EgressCapabilityState", "EgressMeter"] },
    { "tag": "relay-v7", "new_sqlite_classes": ["ProofAuthority"] },
    { "tag": "relay-v8", "new_sqlite_classes": ["PaidGatewayState"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.2 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
