{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true,
    "types": ["@cloudflare/workers-types"], "skipLibCheck": true,
    "noEmit": true, "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["xguard-gateway.ts", "staging.ts"]
}
