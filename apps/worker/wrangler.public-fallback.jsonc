{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-public",
  "main": "src/inference-provider.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "minify": true,
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "XGUARD_ENVIRONMENT": "production",
    "XGUARD_RELEASE": "2.0.0",
    "XGUARD_GIT_COMMIT": "runtime-injected",
    "XGUARD_DEPLOYED_AT": "runtime-injected",
    "MIN_MARGIN_USD": "0.0001",
    "MIN_MARGIN_PERCENT": "15",
    "MAX_DAILY_LOSS_USD": "5",
    "PAYOUT_THRESHOLD_USD": "25",
    "MIN_RESERVE_USD": "5",
    "OPERATING_RESERVE_PERCENT": "20",
    "XGUARD_NETWORK_FEE_PERCENT": "",
    "XGUARD_VARIABLE_INFRA_MICRO_USD_PER_REQUEST": "",
    "XGUARD_MAX_CONCURRENCY": "8",
    "XGUARD_UPSTREAM_TIMEOUT_MS": "60000",
    "XGUARD_UPSTREAM_HOST_ALLOWLIST": "",
  },
  "ratelimits": [
    {
      "name": "NETWORK_RATE_LIMITER",
      "namespace_id": "2101",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "2102",
      "simple": { "limit": 5000, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INFERENCE_COORDINATOR", "class_name": "InferenceCoordinator" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MainnetPaymentCoordinator", "MainnetRequestGate"],
    },
    { "tag": "v2", "new_sqlite_classes": ["XPayGlobalRateGate"] },
    { "tag": "v3", "new_sqlite_classes": ["WebhookDeliveryQueue"] },
    { "tag": "v4", "new_sqlite_classes": ["GatewayRequestCoordinator"] },
    { "tag": "v5", "new_sqlite_classes": ["InferenceCoordinator"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xguard-mainnet",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
