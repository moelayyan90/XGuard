{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-testnet-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "MODE": "testnet",
    "XGUARD_FEE_MICRO_USD": "2000",
    "PAYMENT_IDENTIFIER_TTL_SECONDS": "86400",
    "HEALTH_MAX_AGE_SECONDS": "900",
    "FACILITATORS_JSON": "[{\"id\":\"x402-org-testnet\",\"baseUrl\":\"https://x402.org/facilitator\",\"networks\":[\"eip155:84532\"],\"schemes\":[\"exact\"],\"costMicroUsd\":\"0\",\"priority\":100,\"exactEvmTransferMethods\":[\"eip3009\",\"permit2\"]}]"
  },
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PAYMENT_COORDINATOR", "class_name": "PaymentCoordinator" },
      { "name": "REQUEST_GATE", "class_name": "RequestGate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PaymentCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["RequestGate"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xguard-testnet-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
