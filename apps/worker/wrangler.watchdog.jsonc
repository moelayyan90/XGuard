{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-watchdog",
  "main": "src/mainnet-watchdog.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "minify": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "vars": {
    "WATCHDOG_PRODUCER": "xguard-mainnet",
    "WATCHDOG_MAINNET_URL": "https://xguard-mainnet.maqamapp.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xguard-mainnet",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
}
