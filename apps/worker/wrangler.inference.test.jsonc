{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-inference-test",
  "main": "src/inference-provider.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "vars": {
    "XGUARD_ENVIRONMENT": "test",
    "XGUARD_RELEASE": "2.0.0-test",
    "XGUARD_GIT_COMMIT": "test",
    "XGUARD_DEPLOYED_AT": "test",
    "MIN_MARGIN_USD": "0.000001",
    "MIN_MARGIN_PERCENT": "15",
    "MAX_DAILY_LOSS_USD": "1",
    "PAYOUT_THRESHOLD_USD": "25",
    "MIN_RESERVE_USD": "5",
    "OPERATING_RESERVE_PERCENT": "20",
    "XGUARD_NETWORK_FEE_PERCENT": "5",
    "XGUARD_VARIABLE_INFRA_MICRO_USD_PER_REQUEST": "1",
    "XGUARD_MAX_CONCURRENCY": "2",
    "XGUARD_UPSTREAM_TIMEOUT_MS": "10000",
    "XGUARD_UPSTREAM_HOST_ALLOWLIST": "upstream.test",
    "DGRID_PROVIDER_API_KEY": "test-network-key-0000000000000001",
    "XGUARD_ADMIN_TOKEN": "test-admin-token-00000000000000001",
    "XGUARD_UPSTREAM_1_BASE_URL": "https://upstream.test/v1",
    "XGUARD_UPSTREAM_1_API_KEY": "test-upstream-key-000000000000001",
    "XGUARD_UPSTREAM_1_NAME": "Test self-hosted vLLM",
    "XGUARD_UPSTREAM_1_MODEL": "Qwen/Qwen3-8B",
    "XGUARD_UPSTREAM_1_NETWORK_MODEL": "xguard/qwen3-8b",
    "XGUARD_UPSTREAM_1_RESALE_APPROVED": "true",
    "XGUARD_UPSTREAM_1_LEGAL_EVIDENCE_URL": "https://contracts.example/xguard-upstream",
    "XGUARD_UPSTREAM_1_INPUT_MICRO_USD_PER_MILLION": "100000",
    "XGUARD_UPSTREAM_1_OUTPUT_MICRO_USD_PER_MILLION": "200000",
    "XGUARD_UPSTREAM_1_SALE_INPUT_MICRO_USD_PER_MILLION": "500000",
    "XGUARD_UPSTREAM_1_SALE_OUTPUT_MICRO_USD_PER_MILLION": "800000",
  },
  "ratelimits": [
    {
      "name": "NETWORK_RATE_LIMITER",
      "namespace_id": "3201",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "3202",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INFERENCE_COORDINATOR", "class_name": "InferenceCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InferenceCoordinator"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xguard-inference-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
