{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-testnet",
  "main": "src/inference-provider.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "minify": true,
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "XGUARD_ENVIRONMENT": "test",
    "XGUARD_RELEASE": "2.0.0",
    "XGUARD_GIT_COMMIT": "local",
    "XGUARD_DEPLOYED_AT": "local",
    "MIN_MARGIN_USD": "0.0001",
    "MIN_MARGIN_PERCENT": "15",
    "MAX_DAILY_LOSS_USD": "1",
    "PAYOUT_THRESHOLD_USD": "25",
    "MIN_RESERVE_USD": "5",
    "OPERATING_RESERVE_PERCENT": "20",
    "XGUARD_NETWORK_FEE_PERCENT": "",
    "XGUARD_VARIABLE_INFRA_MICRO_USD_PER_REQUEST": "",
    "XGUARD_MAX_CONCURRENCY": "4",
    "XGUARD_UPSTREAM_TIMEOUT_MS": "30000",
    "XGUARD_UPSTREAM_HOST_ALLOWLIST": "",
  },
  "ratelimits": [
    {
      "name": "NETWORK_RATE_LIMITER",
      "namespace_id": "1201",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "1202",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INFERENCE_COORDINATOR", "class_name": "InferenceCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PaymentCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["RequestGate"] },
    { "tag": "v3", "new_sqlite_classes": ["InferenceCoordinator"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xguard-testnet",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["0 * * * *"] },
}
