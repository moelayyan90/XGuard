{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-economic-preview",
  "main": "src/economic-firewall.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "minify": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "3002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ECONOMIC_INTENT_COORDINATOR",
        "class_name": "EconomicIntentCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EconomicIntentCoordinator"]
    }
  ]
}
