{
  "name": "@xguard/worker",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir ../../dist/worker",
    "build:mainnet": "wrangler deploy --dry-run --config wrangler.mainnet.jsonc --outdir ../../dist/worker-mainnet",
    "build:economic-preview": "wrangler deploy --dry-run --config wrangler.economic-preview.jsonc --outdir ../../dist/worker-economic-preview",
    "dev": "wrangler dev",
    "types": "wrangler types --config wrangler.test.jsonc --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@xguard/core": "0.1.0-alpha.0",
    "@x402/core": "2.22.0",
    "hono": "4.13.2"
  }
}
