{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-mainnet",
  "main": "src/universal-mainnet.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "minify": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "BASE_RPC_URL": "https://base.public.blockpi.network/v1/rpc/public",
    "BASE_RPC_FALLBACK_URLS": "https://mainnet.base.org",
    "XGUARD_FEE_MICRO_USD": "30000",
    "XGUARD_VERIFY_FEE_MICRO_USD": "200",
    "XGUARD_MODEL_FEE_MICRO_USD": "100",
    "XGUARD_TOOL_FEE_MICRO_USD": "200",
    "XGUARD_SOURCE_FEE_MICRO_USD": "1000",
    "XGUARD_ANALYSIS_FEE_MICRO_USD": "2000",
    "XGUARD_SECURITY_FEE_MICRO_USD": "1000",
    "XGUARD_PAYMENT_DECISION_FEE_MICRO_USD": "1000",
    "MIGRATION_OPERATION_FEE_MICRO_USD": "3000000",
    "XPAY_DOWNSTREAM_COST_MICRO_USD": "0",
    "PAYAI_DOWNSTREAM_COST_MICRO_USD": "0",
    "XGUARD_MIN_GROSS_MARGIN_BPS": "7500",
    "XGUARD_ADMIN_TOKEN_SHA256": "4e9ebd63eea15efdeb2926107384937c1fe843d8eeb0bed4180f214d307a239f",
    "ECONOMIC_FIREWALL_SHADOW_MODE": "observe",
    "PAYMENT_IDENTIFIER_TTL_SECONDS": "86400",
    "HEALTH_MAX_AGE_SECONDS": "300",
    "XGUARD_TREASURY_USDC_ADDRESS": "0x4f32f8fe1ee3e9f5c5a6587dc019a13bb453ba07",
  },
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 45, "period": 60 },
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 10000, "period": 60 },
    },
    {
      "name": "WEBHOOK_RATE_LIMITER",
      "namespace_id": "2003",
      "simple": { "limit": 600, "period": 60 },
    },
    {
      "name": "BUYER_PASS_CREATE_RATE_LIMITER",
      "namespace_id": "2004",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAYMENT_COORDINATOR",
        "class_name": "MainnetPaymentCoordinator",
      },
      { "name": "REQUEST_GATE", "class_name": "MainnetRequestGate" },
      { "name": "XPAY_RATE_GATE", "class_name": "XPayGlobalRateGate" },
      {
        "name": "WEBHOOK_DELIVERY_QUEUE",
        "class_name": "WebhookDeliveryQueue",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MainnetPaymentCoordinator", "MainnetRequestGate"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["XPayGlobalRateGate"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["WebhookDeliveryQueue"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xguard-mainnet",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/1 * * * *"] },
}
