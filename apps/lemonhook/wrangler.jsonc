{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xguard-lemonhook",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "minify": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "durable_objects": {
    "bindings": [{ "name": "CREDITS", "class_name": "CreditLedger" }]
  },
  "migrations": [
    { "tag": "lemonhook-v1", "new_sqlite_classes": ["CreditLedger"] }
  ],
  "routes": [
    { "pattern": "hooks.xguardgate.com", "custom_domain": true }
  ]
}
