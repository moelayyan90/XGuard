{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "url": { "type": "string", "title": "URL", "description": "Final public URL extracted." },
      "statusCode": { "type": "integer", "title": "HTTP status" },
      "title": { "type": "string", "title": "Page title" },
      "description": { "type": "string", "title": "Meta description" },
      "lang": { "type": ["string", "null"], "title": "Language" },
      "canonical": { "type": ["string", "null"], "title": "Canonical URL" },
      "markdown": { "type": "string", "title": "Clean Markdown", "description": "Main page content converted to Markdown for LLM and RAG ingestion." },
      "text": { "type": "string", "title": "Clean text" },
      "links": { "type": "array", "title": "Links" },
      "contentLength": { "type": "integer", "title": "Markdown characters" },
      "extractedAt": { "type": "string", "title": "Extracted at" },
      "product": { "type": "string", "title": "Product" },
      "schemaVersion": { "type": "integer", "title": "Schema version" }
    },
    "required": ["url", "statusCode", "markdown", "text", "extractedAt"]
  },
  "views": {
    "overview": {
      "title": "Extracted pages",
      "transformation": {
        "fields": ["url", "statusCode", "title", "description", "contentLength", "extractedAt"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": { "label": "URL", "format": "link" }
        }
      }
    }
  }
}
