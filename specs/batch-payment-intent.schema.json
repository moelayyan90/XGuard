{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xguardgate.com/specs/batch-payment-intent.schema.json",
  "title": "XGuard Batch Payment Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","batchIntentId","claims","totals","executionPolicy","atomicityPolicy","validBefore","nonce","claimsRoot"],
  "properties": {
    "version": { "const": "xguard-batch-intent/1" },
    "batchIntentId": { "type": "string", "minLength": 16, "maxLength": 200 },
    "payer": { "type": "string", "minLength": 1, "maxLength": 300 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId","beneficiary","amount","currency","rail","destination","reference","validBefore"],
        "properties": {
          "claimId": { "type": "string", "minLength": 8, "maxLength": 300 },
          "beneficiary": { "type": "string", "minLength": 1, "maxLength": 300 },
          "amount": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
          "currency": { "type": "string", "minLength": 2, "maxLength": 40 },
          "rail": { "type": "string", "minLength": 1, "maxLength": 100 },
          "destination": { "type": "string", "minLength": 1, "maxLength": 500 },
          "reference": { "type": "string", "minLength": 1, "maxLength": 500 },
          "validBefore": { "type": "string", "format": "date-time" },
          "evidence": { "type": "string", "maxLength": 4000 },
          "groupId": { "type": "string", "maxLength": 200 },
          "mandatory": { "type": "boolean", "default": true }
        }
      }
    },
    "totals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency","amount"],
        "properties": {
          "currency": { "type": "string", "minLength": 2, "maxLength": 40 },
          "amount": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" }
        }
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipient","amount","currency","label"],
        "properties": {
          "recipient": { "type": "string", "minLength": 1, "maxLength": 300 },
          "amount": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
          "currency": { "type": "string", "minLength": 2, "maxLength": 40 },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "executionPolicy": { "enum": ["ATOMIC_ONCHAIN","PLATFORM_SPLIT","COORDINATED_CHILD_PAYMENTS"] },
    "atomicityPolicy": { "enum": ["ALL_OR_NOTHING","BEST_EFFORT","GROUP_ATOMIC"] },
    "validBefore": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 200 },
    "claimsRoot": { "type": "string", "minLength": 16, "maxLength": 200 },
    "payerAuthorization": { "type": "string", "minLength": 16, "maxLength": 8000 }
  }
}
