# LEGACY LOCAL NODE GATEWAY TEST TEMPLATE — NOT PRODUCTION.
# XGuard production mainnet is the Cloudflare Worker configured by
# apps/worker/wrangler.mainnet.jsonc and deployed as xguard-mainnet.
# Do not copy this file to configure or deploy the production mainnet Worker.
# Public, non-secret local/test configuration only. Never place owner banking data here.
NODE_ENV=development
OWNER_BOOTSTRAP_BUDGET_USD=0
PORT=8787
XGUARD_FEE_MICRO_USD=2000
LOW_BALANCE_THRESHOLD_MICRO_USD=20000
OPERATING_RESERVE_PERCENT=20
MIN_OPERATING_RESERVE_MICRO_USD=25000000
OWNER_PAYOUT_MIN_MICRO_USD=100000000
AUTO_OWNER_PAYOUT=true
PAYOUT_CHECK_FREQUENCY=daily
XGUARD_DATABASE_PATH=./xguard.db
XGUARD_PUBLIC_BASE_URL=http://localhost:8787
XGUARD_PUBLIC_TESTNET=true
XGUARD_SUPPORTED_NETWORKS=eip155:84532
XGUARD_MAINNET_ENABLED=false
XGUARD_MAINNET_LEGAL_GATE=BLOCKED
XGUARD_MAINNET_SECURITY_GATE=BLOCKED
XGUARD_MAINNET_RECONCILIATION_GATE=BLOCKED
XGUARD_MAINNET_OPERATIONAL_GATE=BLOCKED
PAYOUT_PROVIDER_AUTHORIZED=false
PAYOUT_DESTINATION_VERIFIED=false
PAYOUT_KYC_COMPLETE=false

# Optional public OKX API host override. Global accounts use openapi.okx.com.
# Regional accounts must use the domain assigned by OKX.
OKX_API_BASE_URL=https://openapi.okx.com

# Global opportunity hunter. Production secrets belong in the encrypted Worker secret store.
# Shadow mode scores and stores only. Live mode submits only pre-funded, verified,
# strict-Shariah-approved opportunities to the configured execution connector.
HUNTER_AUTOMATION_MODE=shadow
HUNTER_MIN_NET_PROFIT_MICRO_USD=100000000
HUNTER_MIN_MARGIN_BPS=2000
HUNTER_MIN_SCORE=80
HUNTER_MAX_RISK_SCORE=35
HUNTER_MAX_AGE_SECONDS=1800
HUNTER_EXECUTION_WEBHOOK_URL=

# Secret names. Populate through the deployment platform's encrypted secret store.
XGUARD_ADMIN_TOKEN=
XGUARD_API_KEY_PEPPER=
XGUARD_WEBHOOK_SECRET=
PAYOUT_PROVIDER_API_KEY=
PAYOUT_DESTINATION_SECRET_REF=
XGUARD_TREASURY_USDC_ADDRESS=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
HUNTER_INGEST_SECRET=
HUNTER_EXECUTION_WEBHOOK_SECRET=
