# Documentation only. Production secrets belong in Cloudflare Secrets.
# Writer 6 enables bounded x402 commerce after the compatible reader release.
# Cards still require verified merchant configuration and a funded canary.
# An email address alone cannot activate card checkout.
NODE_ENV=production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
PAYPAL_ENVIRONMENT=live
PAYPAL_VERIFIED_EMAIL=
PAYPAL_ENABLED=off

# Existing x402 rail. No default address or signing key is invented.
XGUARD_PAYMENT_ENVIRONMENT=production
XGUARD_TREASURY_USDC_ADDRESS=
XGUARD_PAID_FACILITATOR=
X402_BASE_PRIMARY=
LIVE_PAID_SERVICES=on
XGUARD_LIVE_PAID_COST_BUDGET_USD_MICROS=1500
XGUARD_ACTION_DAILY_ORDERS=100
LIVE_ADMIN_KEY=
XGUARD_OPERATOR_KEY=

# Optional operator-approved contractual inventory, maximum 30 records.
# Fields: id, name, capabilities[], offer_url (HTTPS without query credentials),
# agreement_reference, agreement_valid_until, commission_bps. No sample suppliers.
XGUARD_APPROVED_PARTNERS_JSON=[]

# Reserved dependencies below are NOT active adapters in the present release.
# Supplying one of these does not activate direct deposits, OKX or a new rail.
BASE_CHAIN_ID=8453
BASE_RPC_URL=
BASE_USDC_CONTRACT=
BASE_USDC_RECEIVER_ADDRESS=
OKX_BASE_USDC_DEPOSIT_ADDRESS=
X402_FACILITATOR_URL=
X402_NETWORK=eip155:8453
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SIGNING_SECRET=
INTERNAL_API_KEY_SECRET=
DATABASE_URL=
AUDIT_SIGNING_KEY=
REVENUE_SHARE_ENABLED=false
PAY_PER_USE_ENABLED=true
COMMERCIAL_CHECKOUT_ENABLED=false
