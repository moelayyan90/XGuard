{
  "manifest_version": 3,
  "name": "XGuard Payment Layer",
  "version": "0.2.0",
  "description": "A floating payment layer that remembers payees, defers bills, coordinates single or multi-payment sessions, and supports payment splitting without merchant integration.",
  "homepage_url": "https://xguardgate.com/",
  "permissions": ["storage"],
  "host_permissions": ["https://xguardgate.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "exclude_matches": [
        "https://xguardgate.com/*",
        "https://www.xguardgate.com/*"
      ],
      "js": ["universal-layer.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "XGuard Payment Layer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
