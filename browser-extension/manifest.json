{
  "manifest_version": 3,
  "name": "XGuard Payment Decision",
  "version": "0.1.0",
  "description": "Optional buyer-side pre-payment verification and transaction evidence. No fee for showing or skipping XGuard.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://xguardgate.com/*",
    "https://www.xguardgate.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "XGuard Payment Decision"
  }
}
